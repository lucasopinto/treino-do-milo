# Copie para api/.env (no computador) ou cadastre como variáveis de ambiente no servidor.

# Local: SQLite (padrão). Produção: a URL do Neon (postgresql://usuario:senha@host/banco?sslmode=require)
# MILO_DATABASE_URL=sqlite:///./milo.db

# Chaves do Web Push. Gere com:  python -m app.tools.vapid
MILO_VAPID_PUBLIC_KEY=
MILO_VAPID_PRIVATE_KEY=
# Contato exigido pelo Web Push (um e-mail seu, no formato mailto:).
MILO_VAPID_SUBJECT=mailto:seu-email@example.com

# Segredo que o cron-job.org manda no cabeçalho X-Cron-Secret. Invente uma senha longa.
MILO_CRON_SECRET=

# Opcional: fuso da agenda de saídas (padrão America/Sao_Paulo)
# MILO_TIMEZONE=America/Sao_Paulo
